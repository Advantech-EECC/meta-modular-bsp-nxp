diff --git a/board/nxp/imx8mq_evk/Makefile b/board/nxp/imx8mq_evk/Makefile
index 63b7248b56a..1c32e41e6ec 100644
--- a/board/nxp/imx8mq_evk/Makefile
+++ b/board/nxp/imx8mq_evk/Makefile
@@ -8,9 +8,6 @@ obj-y += imx8mq_evk.o
 
 ifdef CONFIG_XPL_BUILD
 obj-y += spl.o
-ifdef CONFIG_IMX8MQ_4GB_DDR_TIMING
-obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_4g.o
-else
-obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_b0.o lpddr4_timing.o
-endif
+obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_2g.o
+obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing_b0.o
 endif
