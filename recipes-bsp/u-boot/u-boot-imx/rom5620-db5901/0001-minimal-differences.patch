diff --git a/board/nxp/imx8qxp_mek/imx8qxp_mek.c b/board/nxp/imx8qxp_mek/imx8qxp_mek.c
index f3d81042ad1..9e6a66149b8 100644
--- a/board/nxp/imx8qxp_mek/imx8qxp_mek.c
+++ b/board/nxp/imx8qxp_mek/imx8qxp_mek.c
@@ -68,6 +68,14 @@ int board_early_init_f(void)
 
 	setup_iomux_uart();
 
+/* Dual bootloader feature will require CAAM access, but JR0 and JR1 will be
+ * assigned to seco for imx8, use JR3 instead.
+ */
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_DUAL_BOOTLOADER)
+	sc_pm_set_resource_power_mode(-1, SC_R_CAAM_JR3, SC_PM_PW_MODE_ON);
+	sc_pm_set_resource_power_mode(-1, SC_R_CAAM_JR3_OUT, SC_PM_PW_MODE_ON);
+#endif
+
 	return 0;
 }
 
@@ -94,6 +102,37 @@ static void board_gpio_init(void)
 static inline void board_gpio_init(void) {}
 #endif
 
+#if IS_ENABLED(CONFIG_FEC_MXC)
+#include <miiphy.h>
+
+int board_phy_config(struct phy_device *phydev)
+{
+	int val;
+
+	/* RTL8211F page 0xd04: LED configuration */
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x1f, 0x0d04);
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0xa050);
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x11, 0x0000);
+
+	/* RTL8211F page 0xd08: enable RGMII TX and RX delays */
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x1f, 0x0d08);
+	val = phy_read(phydev, MDIO_DEVAD_NONE, 0x11);
+	if (val >= 0)
+		phy_write(phydev, MDIO_DEVAD_NONE, 0x11, val | BIT(8));
+
+	val = phy_read(phydev, MDIO_DEVAD_NONE, 0x15);
+	if (val >= 0)
+		phy_write(phydev, MDIO_DEVAD_NONE, 0x15, val | BIT(3));
+
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x1f, 0x0000);
+
+	if (phydev->drv->config)
+		phydev->drv->config(phydev);
+
+	return 0;
+}
+#endif
+
 int checkboard(void)
 {
 #ifdef CONFIG_TARGET_IMX8DX_MEK
@@ -212,6 +251,37 @@ int board_usb_cleanup(int index, enum usb_init_type init)
 }
 #endif
 
+static iomux_cfg_t wdt_trig[] = {
+	SC_P_ADC_IN4 | MUX_MODE_ALT(4) | MUX_PAD_CTRL(GPIO_PAD_CTRL),
+};
+
+static void setup_iomux_wdt(void)
+{
+	int ret;
+	struct gpio_desc desc = {};
+	struct udevice *dev;
+
+	imx8_iomux_setup_multiple_pads(wdt_trig, ARRAY_SIZE(wdt_trig));
+
+	ret = uclass_get_device_by_seq(UCLASS_GPIO, 1, &dev);
+	if (ret) {
+		printf("%s failed to find GPIO1 device, ret = %d\n", __func__, ret);
+		return;
+	}
+
+	desc.dev = dev;
+	desc.offset = 14;
+
+	ret = dm_gpio_request(&desc, "wdt_trig");
+	if (ret) {
+		printf("%s request wdt_trig failed ret = %d\n", __func__, ret);
+		return;
+	}
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_OUT);
+	dm_gpio_set_value(&desc, 1);
+}
+
 int board_init(void)
 {
 	board_gpio_init();
@@ -229,6 +299,7 @@ int board_init(void)
 	}
 #endif
 
+	setup_iomux_wdt();
 	return 0;
 }
 
@@ -298,6 +369,46 @@ static void setup_eth_mac_if_empty(int dev_id, const char *envname)
 }
 #endif
 
+static iomux_cfg_t debug_uart_sel_gpio[] = {
+	SC_P_SAI0_RXD | MUX_MODE_ALT(4) | MUX_PAD_CTRL(GPIO_PAD_CTRL),
+};
+
+static void debug_uart_sel(void)
+{
+	int value;
+	int ret;
+	struct gpio_desc desc = {};
+	struct udevice *dev;
+
+	imx8_iomux_setup_multiple_pads(debug_uart_sel_gpio, ARRAY_SIZE(debug_uart_sel_gpio));
+
+	ret = uclass_get_device_by_seq(UCLASS_GPIO, 0, &dev);
+	if (ret) {
+		printf("%s failed to find GPIO0 device, ret = %d\n", __func__, ret);
+		return;
+	}
+
+	desc.dev = dev;
+	desc.offset = 27;
+
+	ret = dm_gpio_request(&desc, "debug_uart_sel");
+	if (ret) {
+		printf("%s request debug_uart_sel failed ret = %d\n", __func__, ret);
+		return;
+	}
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_IN);
+	value = dm_gpio_get_value(&desc);
+	dm_gpio_free(dev, &desc);
+
+	/* High: enable debug log. Low: disable debug log. */
+	if (value == 0) {
+		env_set("console", "disabled");
+		env_set("earlycon", "disabled");
+		env_set("mmcargs", "setenv bootargs console=${console},${baudrate} earlycon=${earlycon},${baudrate} root=${mmcroot}");
+	}
+}
+
 int board_late_init(void)
 {
 	char *fdt_file;
@@ -327,12 +438,12 @@ int board_late_init(void)
 		if (m4_booted)
 			env_set("fdt_file", "imx8dx-mek-rpmsg.dtb");
 		else
-			env_set("fdt_file", "imx8dx-mek.dtb");
+			env_set("fdt_file", CONFIG_DEFAULT_FDT_FILE);
 #else
 		if (m4_booted)
 			env_set("fdt_file", "imx8qxp-mek-rpmsg.dtb");
 		else
-			env_set("fdt_file", "imx8qxp-mek.dtb");
+			env_set("fdt_file", CONFIG_DEFAULT_FDT_FILE);
 #endif
 	}
 
@@ -344,6 +455,7 @@ int board_late_init(void)
 	setup_eth_mac_if_empty(0, "ethaddr");
 #endif
 
+	debug_uart_sel();
 	return 0;
 }
 
