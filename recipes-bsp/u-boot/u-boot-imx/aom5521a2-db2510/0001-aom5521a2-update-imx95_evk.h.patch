 		board_late_mmc_env_init();
 
+	aom5521_mac_from_nor();
+
 	env_set("sec_boot", "no");
 #ifdef CONFIG_AHAB_BOOT
 	env_set("sec_boot", "yes");
@@ -545,8 +614,35 @@ static int board_fix_19x19_evk(void *fdt)
 }
 #endif
 
+/*
+ * AOM-5521 has no display on the EVK's MIPI-DSI -> ADV7535 path (its HDMI
+ * bridge is an LT9611UXC). Disable the EVK video pipeline so U-Boot does
+ * not try to probe it.
+ */
+static void aom5521_disable_display(void *fdt)
+{
+	int off, ret;
+
+	for (off = fdt_next_node(fdt, -1, NULL); off >= 0;
+	     off = fdt_next_node(fdt, off, NULL)) {
+		const char *name = fdt_get_name(fdt, off, NULL);
+
+		if ((!name || strncmp(name, "display-controller@4b400000", 27)) &&
+		    fdt_node_check_compatible(fdt, off, "adi,adv7535"))
+			continue;
+
+		ret = fdt_setprop_string(fdt, off, "status", "disabled");
+		if (ret == -FDT_ERR_NOSPACE && !fdt_increase_size(fdt, 512))
+			ret = fdt_setprop_string(fdt, off, "status", "disabled");
+		if (ret)
+			printf("%s: %s: %d\n", __func__, name, ret);
+	}
+}
+
 int board_fix_fdt(void *fdt)
 {
+	aom5521_disable_display(fdt);
+
 	/* Remove nodes based on fuses. */
 	board_fix_fdt_fuse(fdt);
 	
