+static void __maybe_unused netc_phy_rst(const char *gpio_name, const char *label)
 {
 	int ret;
 	struct gpio_desc desc;
@@ -250,25 +331,11 @@ void netc_init(void)
 	netc_phy_rst("gpio@22_4", "ENET1_RST_B");
 	netc_phy_rst("gpio@22_5", "ENET2_RST_B");
 #else
