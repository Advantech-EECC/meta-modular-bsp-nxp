+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * AOM-5521 (i.MX95) on SOM-DB2510 - U-Boot board overrides.
+ *
+ * Included from imx95-19x19-evk-u-boot.dtsi, which U-Boot appends to the
+ * board DTS, so everything here overrides the EVK description.
+ *
+ * Module schematic AOM-5521 A101-1, sheets 11, 20, 21:
+ *  - SoC ENET1 pads (enetc_port0) -> RTL8211FSI @ MDIO 3 -> SMARC GBE1
+ *  - SoC ENET2 pads (enetc_port1) -> RTL8211FSI @ MDIO 1 -> SMARC GBE0
+ *  - Shared central EMDIO on ENET1_MDC/ENET1_MDIO.
+ *  - PHY rails always on, PHYRSTB = RESET_OUT_3V3# (POR_B): no phy-supply,
+ *    no reset-gpios. The EVK's aqr/mac regulators and expanders don't exist.
+ *  - RXDLY strapped, RGMII I/O at 1.8 V: rgmii-id.
+ *  - enetc_port2 (USXGMII) -> SMARC SERDES_0, no PHY on module: disabled.
+ */
+
+/ {
+	aliases {
+		ethernet0 = &enetc_port1;	/* GBE0, PHY@1 */
+		ethernet1 = &enetc_port0;	/* GBE1, PHY@3 */
+		/delete-property/ ethernet2;
+	};
+};
+
+&netc_emdio {
+	/delete-property/ phy-supply;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_emdio>;
+	status = "okay";
+
+	aom_gbe0_phy: ethernet-phy@1 {
+		reg = <1>;
+		realtek,clkout-disable;
+		/delete-property/ phy-supply;
+		/delete-property/ reset-gpios;
+		/delete-property/ reset-assert-us;
+		/delete-property/ reset-deassert-us;
+	};
+
+	aom_gbe1_phy: ethernet-phy@3 {
+		reg = <3>;
+		realtek,clkout-disable;
+	};
+};
+
+&enetc_port0 {
+	/delete-property/ phy-supply;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_enetc0>;
+	phy-handle = <&aom_gbe1_phy>;
+	phy-mode = "rgmii-id";
+	status = "okay";
+};
+
+&enetc_port1 {
+	/delete-property/ phy-supply;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_aom_enetc1>;
+	phy-handle = <&aom_gbe0_phy>;
+	phy-mode = "rgmii-id";
+	status = "okay";
+};
+
+&enetc_port2 {
+	/delete-property/ phy-handle;
+	/delete-property/ phy-supply;
+	status = "disabled";
+};
+
+&scmi_iomuxc {
+	pinctrl_aom_enetc1: aomenetc1grp {
+		fsl,pins = <
+			IMX95_PAD_ENET2_TD3__NETCMIX_TOP_ETH1_RGMII_TD3		0x57e
+			IMX95_PAD_ENET2_TD2__NETCMIX_TOP_ETH1_RGMII_TD2		0x57e
+			IMX95_PAD_ENET2_TD1__NETCMIX_TOP_ETH1_RGMII_TD1		0x57e
+			IMX95_PAD_ENET2_TD0__NETCMIX_TOP_ETH1_RGMII_TD0		0x57e
+			IMX95_PAD_ENET2_TX_CTL__NETCMIX_TOP_ETH1_RGMII_TX_CTL	0x57e
+			IMX95_PAD_ENET2_TXC__NETCMIX_TOP_ETH1_RGMII_TX_CLK	0x58e
+			IMX95_PAD_ENET2_RX_CTL__NETCMIX_TOP_ETH1_RGMII_RX_CTL	0x57e
+			IMX95_PAD_ENET2_RXC__NETCMIX_TOP_ETH1_RGMII_RX_CLK	0x58e
+			IMX95_PAD_ENET2_RD0__NETCMIX_TOP_ETH1_RGMII_RD0		0x57e
+			IMX95_PAD_ENET2_RD1__NETCMIX_TOP_ETH1_RGMII_RD1		0x57e
+			IMX95_PAD_ENET2_RD2__NETCMIX_TOP_ETH1_RGMII_RD2		0x57e
+			IMX95_PAD_ENET2_RD3__NETCMIX_TOP_ETH1_RGMII_RD3		0x57e
+		>;
+	};
+};
+
+/*
+ * EVK-only parts that are not on the module or carrier. Disabling the
+ * I2C GPIO expanders stops the pca953x "Error reading output register"
+ * messages; the regulators they switched become plain fixed rails.
+ */
+&i2c3_gpio_expander_20 {
+	status = "disabled";
+};
+
+&i2c4_gpio_expander_21 {
+	status = "disabled";
+};
+
+&i2c5_pcal6408 {
+	status = "disabled";
+};
+
+&i2c6_pcal6416 {
+	status = "disabled";
+};
+
+&i2c7_pcal6524 {
+	status = "disabled";
+};
+
+&adp5585 {
+	status = "disabled";
+};
+
+&reg_audio_pwr {
+	/delete-property/ gpio;
+	/delete-property/ enable-active-high;
+};
+
+&reg_m2_pwr {
+	/delete-property/ gpio;
+	/delete-property/ enable-active-high;
+};
+
+&reg_pcie0 {
+	/delete-property/ gpio;
+	/delete-property/ enable-active-high;
+};
+
+&reg_slot_pwr {
+	/delete-property/ gpio;
+	/delete-property/ enable-active-high;
+};
+
+&reg_usb_vbus {
+	/delete-property/ gpio;
+	/delete-property/ enable-active-high;
+};
+
+&pcie0 {
+	/delete-property/ reset-gpio;
+};
+
+&pcie1 {
+	/delete-property/ reset-gpio;
+};
+
+/* GPIO_IO25/GPIO_IO27 are LCD1_BKLT_PWM / SW_RESET_OUT# on AOM-5521 */
+&flexcan2 {
+	status = "disabled";
+};
+
+&flexcan1_phy {
+	status = "disabled";
+};
+
+&flexcan2_phy {
+	status = "disabled";
+};
